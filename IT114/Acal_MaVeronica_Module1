<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tuition Fee Portal</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            max-width: 700px;
            margin: 20px auto;
            padding: 15px;
            background: linear-gradient(135deg, #f8f9ff, #e8ecff);
        }
        .container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0,48,135,0.12);
            overflow: hidden;
            border: 1px solid #1e3a8a;
        }
        .header {
            background: linear-gradient(45deg, #1e40af, #1e3a8a);
            color: white;
            padding: 20px;
            text-align: center;
        }
        .header h1 { margin: 0; font-size: 1.6em; }
        .header p { margin: 5px 0 0 0; opacity: 0.9; }
        .fee-breakdown {
            padding: 20px;
            background: #f8fafc;
            transition: opacity 0.5s ease-out;
        }
        .fee-breakdown.hidden {
            display: none;
        }
        .fee-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 15px;
            background: white;
            margin: 8px 0;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(30,58,138,0.08);
            font-size: 1em;
            font-weight: 500;
            border-left: 4px solid #1e40af;
            transition: all 0.3s;
        }
        .fee-item.hidden {
            display: none;
        }
        .total-section {
            background: linear-gradient(135deg, #dbeafe, #bfdbfe);
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
            text-align: center;
            border: 1px solid #1e3a8a;
        }
        .total-amount {
            font-size: 2em;
            color: #1e3a8a;
            font-weight: bold;
        }
        .payment-section {
            padding: 20px;
            background: linear-gradient(135deg, #eff6ff, #e0f2fe);
            border-top: 2px solid #1e3a8a;
        }
        .payment-inputs input {
            padding: 12px;
            border: 2px solid #e0e7ff;
            border-radius: 8px;
            font-size: 1.1em;
            text-align: right;
            width: 100%;
            box-sizing: border-box;
        }
        .payment-inputs input:focus {
            border-color: #1e40af;
            box-shadow: 0 0 10px rgba(30,64,175,0.2);
        }
        button {
            background: linear-gradient(45deg, #1e40af, #1e3a8a);
            color: white;
            border: none;
            padding: 14px 30px;
            border-radius: 25px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: 15px;
            box-shadow: 0 5px 15px rgba(30,58,138,0.3);
        }
        button:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(30,58,138,0.4);
        }
        .remaining-display {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            color: #92400e;
            padding: 20px;
            text-align: center;
            margin: 20px 0;
            border-radius: 10px;
            font-size: 1.2em;
            font-weight: bold;
            border: 2px solid #f59e0b;
        }
        .error {
            background: linear-gradient(135deg, #fee2e2, #fecaca) !important;
            color: #dc2626 !important;
            border: 2px solid #dc2626 !important;
        }
        .paid-full {
            background: linear-gradient(135deg, #dcfce7, #bbf7d0) !important;
            color: #166534 !important;
            border: 2px solid #22c55e !important;
        }
        .payment-history {
            margin-top: 20px;
            max-height: 250px;
            overflow-y: auto;
            padding: 15px;
            background: white;
            border-radius: 8px;
            border: 1px solid #e0e7ff;
            font-size: 0.95em;
        }
        .payment-record {
            background: linear-gradient(135deg, #dbeafe, #bfdbfe);
            padding: 12px 15px;
            margin: 10px 0;
            border-radius: 8px;
            border-left: 4px solid #1e40af;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .payment-record:hover {
            transform: translateX(4px);
            box-shadow: 0 4px 12px rgba(30,58,138,0.2);
        }
        .payment-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        .payment-header .amount {
            font-size: 1.1em;
            font-weight: bold;
        }
        .payment-header .date {
            opacity: 0.8;
            font-size: 0.9em;
        }
        .payment-header .toggle {
            font-size: 1.2em;
            transition: transform 0.3s ease;
        }
        .payment-header.expanded .toggle {
            transform: rotate(180deg);
        }
        .allocations {
            display: none;
            margin-top: 8px;
            padding: 12px;
            background: rgba(255,255,255,0.8);
            border-radius: 6px;
            border-left: 3px solid #22c55e;
        }
        .allocations.expanded {
            display: block;
            animation: slideDown 0.3s ease-out;
        }
        @keyframes slideDown {
            from { opacity: 0; max-height: 0; }
            to { opacity: 1; max-height: 200px; }
        }
        .allocation-item {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.9em;
            border-bottom: 1px solid rgba(30,58,138,0.1);
        }
        .allocation-item:last-child {
            border-bottom: none;
        }
        h2, h3 { color: #1e3a8a; font-size: 1.1em; }
        label { font-weight: 600; color: #1e3a8a; margin-bottom: 8px; display: block; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>MALAYAN COLLEGES LAGUNA</h1>
            <p>Tuition Fee Management Portal</p>
        </div>

        <div class="fee-breakdown" id="feeBreakdown">
            <h2>Fee Breakdown</h2>
            <!-- Fee display that UPDATES with remaining amount (NO GREEN) -->
            <div class="fee-item" id="matriculationFee" data-original="14355" data-name="MATRICULATION FEE">
                <span id="feeAmount">₱14,355</span>
                <span>MATRICULATION FEE</span>
            </div>

            <div class="total-section">
                <h3>Total Amount Due</h3>
                <div class="total-amount" id="totalDue">₱14,355</div>
            </div>
        </div>

        <div class="payment-section">
            <h2>Payment</h2>
            <div class="payment-inputs">
                <label>Amount:</label>
                <input type="number" id="paymentAmount" step="0.01" min="0.01" placeholder="Enter amount">
            </div>
            <button onclick="processPayment()">Process Payment</button>

            <div class="remaining-display" id="remainingDisplay">
                <div>Remaining Balance</div>
                <div id="remainingAmount">₱14,355</div>
            </div>

            <div class="payment-history">
                <h3>Payment History</h3>
                <div id="historyList">No payments recorded.</div>
            </div>
        </div>
    </div>

    <script>
        // GLOBAL STATE
        let totalDue = 14355;
        let currentBalance = totalDue;
        let payments = [];
        
        // DOM REFERENCES
        const feeAmountEl = document.getElementById('feeAmount');
        const matriculationFeeEl = document.getElementById('matriculationFee');
        const totalDueEl = document.getElementById('totalDue');
        const remainingAmountEl = document.getElementById('remainingAmount');

        function formatCurrency(amount) {
            return '₱' + Math.round(amount).toLocaleString('en-PH');
        }

        function validatePayment(amountStr) {
            const amount = parseFloat(amountStr);
            if (!amountStr || amountStr.trim() === '' || isNaN(amount)) {
                showError('Please enter a valid amount.');
                return false;
            }
            if (amount <= 0) {
                showError('Amount must be greater than zero.');
                return false;
            }
            if (amount > currentBalance) {
                showError(`Amount exceeds remaining balance of ${formatCurrency(currentBalance)}.`);
                return false;
            }
            return amount;
        }

        function showError(message) {
            const remainingDiv = document.getElementById('remainingDisplay');
            remainingDiv.innerHTML = `<div>${message}</div>`;
            remainingDiv.className = 'error';
            setTimeout(() => {
                remainingDiv.className = 'remaining-display';
                remainingDiv.innerHTML = `<div>Remaining Balance</div><div id="remainingAmount">${formatCurrency(currentBalance)}</div>`;
            }, 3000);
        }

        function processPayment() {
            const amountInput = document.getElementById('paymentAmount').value;
            const amount = validatePayment(amountInput);
            if (!amount) return;

            currentBalance = Math.max(0, currentBalance - amount);
            
            const allocations = [{ name: 'MATRICULATION FEE', amount }];
            const now = new Date().toLocaleString('en-PH');
            payments.unshift({ amount, date: now, allocations });

            // UPDATE DISPLAYS - Fee shows remaining amount (NO GREEN styling)
            feeAmountEl.textContent = formatCurrency(currentBalance);
            totalDueEl.textContent = formatCurrency(currentBalance);
            remainingAmountEl.textContent = formatCurrency(currentBalance);
            
            const remainingDiv = document.getElementById('remainingDisplay');
            if (currentBalance === 0) {
                remainingDiv.className = 'paid-full';
                remainingDiv.innerHTML = '<div>Fully Paid</div><div>All fees settled.</div>';
                document.getElementById('feeBreakdown').classList.add('hidden');
            } else {
                remainingDiv.className = 'remaining-display';
            }

            // PAYMENT HISTORY (unchanged)
            const historyDiv = document.getElementById('historyList');
            if (payments.length === 1) historyDiv.innerHTML = '';

            const paymentDiv = document.createElement('div');
            paymentDiv.className = 'payment-record';

            const header = document.createElement('div');
            header.className = 'payment-header';
            header.innerHTML = `
                <span class="amount">Paid ${formatCurrency(amount)}</span>
                <span class="date">${now}</span>
                <span class="toggle">▾</span>
            `;

            const allocationsDiv = document.createElement('div');
            allocationsDiv.className = 'allocations';
            allocations.forEach(alloc => {
                const item = document.createElement('div');
                item.className = 'allocation-item';
                item.innerHTML = `
                    <span>- ${formatCurrency(alloc.amount)}</span>
                    <span>${alloc.name}</span>
                `;
                allocationsDiv.appendChild(item);
            });

            header.addEventListener('click', () => {
                const isExpanded = allocationsDiv.classList.contains('expanded');
                if (isExpanded) {
                    allocationsDiv.classList.remove('expanded');
                    header.classList.remove('expanded');
                    header.querySelector('.toggle').textContent = '▾';
                } else {
                    allocationsDiv.classList.add('expanded');
                    header.classList.add('expanded');
                    header.querySelector('.toggle').textContent = '▴';
                }
            });

            paymentDiv.appendChild(header);
            paymentDiv.appendChild(allocationsDiv);
            historyDiv.insertBefore(paymentDiv, historyDiv.firstChild);

            document.getElementById('paymentAmount').value = '';
            document.getElementById('paymentAmount').focus();
        }

        document.addEventListener('keypress', e => {
            if (e.key === 'Enter' && document.activeElement.id === 'paymentAmount') {
                processPayment();
            }
        });

        window.onload = () => document.getElementById('paymentAmount').focus();
    </script>
</body>
</html>
